                            <span class="number">8,514</span>USD
                        </div>
                    </li>
                </ul>
            </div>
            <div class="row block hierarchy">
                <div class="col-xs-12 title">
                    Agent hierarchy</div>
                <div class="col-xs-12 row-block noBorder lastRow">
                    <div class="col-xs-7">
                        <img src="~/content/themes/images/hierarchy.png" class="img-responsive" title="hierarchy" />
                    </div>
                    <ul class="col-xs-5 list-unstyled levelList">
                        <li><a href="#">Viren Shareholder</a></li>
                        <li><a href="#">Viren Agent</a></li>
                        <li><a href="#">Agent 1</a></li>
                        <li><a href="#">Agent 01</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col">
