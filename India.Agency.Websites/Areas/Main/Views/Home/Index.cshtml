@{
    ViewBag.Title = "India Agency";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row contentContainer dashboard">
    <div class="col-sm-12">
        <div class="col-sm-6 col">
            <div class="row block balanceInfo">
                <div class="col-xs-12 title">
                    Balance Info</div>
