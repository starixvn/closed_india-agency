@{
    string currentUrl = ViewBag.CurrentUrl ?? Url.Action("Index", "Dashboard", new { area = "Customer" });
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Labels.IndiaAgency</title>
    @Styles.Render("~/styles/layout")
    @Scripts.Render("~/scripts/headjs")
</head>
<body>
    <div class="container-fluid page">
        <header class="header">
            <div class="topHeader">
                <a class="logo" href="#"></a>
                <div class="banner">
                    @Html.Partial("~/Areas/Customer/Views/Home/_ProfileMenus.cshtml")
                    <marquee behavior="scroll" direction="left" class="message hide">
                        <span class="icon-notice"></span> @* Message content *@
                    </marquee>
                </div>
            </div>
            <div class="bottomHeader">
                <div class="search">
                    <input type="text" id="txtSearch" class="txtSearch" placeholder="Username" />
                    <span id="spanCollapse" class="icon-collapse active"></span>
                </div>
                <div class="rightHeader">
                    @Html.Partial("~/Areas/Customer/Views/Home/_TopMenus.cshtml")
                    <div class="dateTime"><span id="spanServerTime"></span>  @Labels.GMT<span id="spanTimezone"></span></div>
                </div>
            </div>
        </header>
        <section class="content">
            <div id="divLeftPanel" class="leftPanel ">
                @Html.Partial("~/Areas/Customer/Views/Home/_LeftPanel.cshtml")
            </div>
            <div id="divRightPanel" class="rightPanel expand">
                <iframe id="ifrMainContent" name="MainContent" frameborder="0" src="@currentUrl"></iframe>
            </div>
        </section>
    </div>
    @Html.Partial("_AppSettings")
    @Scripts.Render("~/scripts/layout")
    @Scripts.Render("~/scripts/languages")
</body>
</html>