<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/styles/layout")
    @Scripts.Render("~/scripts/headjs")
</head>
<body>
    <div class="container-fluid page">
        <header class="header">
            <div class="topHeader">
                <a class="logo" href="#"></a>
                <div class="banner">
                    <ul class="list-unstyled list-inline info">
                        <li class="username">
                            <span class="icon-username"></span>
                            <ul class="userInfo list-unstyled">
                                <li class="avatar">Welcome <br /> <span class="username">Alice</span></li>
                                <li><a href="#"><span class="icon-profile"></span> Profile Setting</a></li>
                                <li><a href="#"><span class="icon-changePass"></span> Change Password</a></li>
                                <li><a href="#"><span class="icon-signOut"></span> Sign Out</a></li>
                            </ul>
                        </li>
                        <li class="hide">
                            <div class="numberMessage">
                                <span class="icon-message"></span>
                                <span class="number">12</span>
                            </div>
                        </li>
                        <li class="hide"><span class="icon-help"></span></li>
                        <li class="flagList">
                            <div class="flag en active">English <span class="icon-arrow-down"></span>
                                <ul class="list-unstyled list">
                                    <li class="flag in">हिन्दी</li>
                                    <li class="flag en">English</li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                    <marquee behavior="scroll" direction="left" class="message hide">
                        <span class="icon-notice"></span> @* Message content *@
                    </marquee>
                </div>
            </div>
            <div class="bottomHeader">
                <div class="search">
                    <input type="text" class="txtSearch" placeholder="Username" />
                    <span class="icon-collapse"></span>
                </div>
                <div class="rightHeader">
                    <ul class="list-unstyled list-inline topMenu">
                        <li class="current"><a href="#">Home</a></li>
                        <li>Report
                            <ul class="list-unstyled subMenu">
                                <li><a href="#">Report 01</a></li>
                                <li><a href="#">Report 01</a></li>
                                <li><a href="#">Report 01</a></li>
                                <li><a href="#">Report 01</a></li>
                            </ul>
                        </li>
                        <li>Customer management
                            <ul class="list-unstyled subMenu">
                                <li><a href="#">Customer management 01</a></li>
                                <li><a href="#">Customer management 01</a></li>
                                <li><a href="#">Customer management 01</a></li>
                                <li><a href="#">Customer management 01</a></li>
                            </ul>
                        </li>
                        <li><a href="#">Total Bet & Forecast</a></li>
                    </ul>
                    <div class="dateTime">3:28:19 AM Sept 3, 2013 GMT-4</div>
                </div>
            </div>
        </header>
        <section class="content">
            <div class="leftPanel hide">
                <div class="container">
                    <div class="row title">Customer Info</div>
                    <div class="row"></div>
                </div>
                <div class="container">
                    <div class="row title">Customer Balance</div>
                    <div class="row"></div>
                </div>
                <ul class="container list-unstyled featureList">
                    <li><a href="#"><span class="icon-newCustomer"></span>New Customer</a></li>
                    <li><a href="#"><span class="icon-infoCustomer"></span>Customer Info</a></li>
                    <li><a href="#"><span class="icon-password"></span>Reset Password</a></li>
                    <li><a href="#"><span class="icon-cricket"></span>Cricket</a></li>
                    <li><a href="#"><span class="icon-sportbook"></span>Sportbook</a></li>
                    <li><a href="#"><span class="icon-positionTaking"></span>View Position Taking</a></li>
                    <li><a href="#"><span class="icon-commission"></span>View Commission</a></li>
                </ul>
            </div>
            <div class="rightPanel expandRight">
                <iframe id="ifrMainContent" name="MainContent" frameborder="0" src="@Url.Content("~/Customer/Dashboard")"></iframe>
            </div>
        </section>
    </div>
    @Scripts.Render("~/scripts/layout")
</body>
</html>